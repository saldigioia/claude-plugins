.DS_Store
*.pyc
__pycache__/
node_modules/
.env
.env.local

# Personal / machine-local Claude Code state
.claude/settings.local.json
.full-review/

# Demo build artifacts
demos/**/node_modules/
demos/**/dist/
demos/**/.astro/

# Local packaging artifacts and editor backups. publish.sh stages with
# `git add --all`, so anything left lying around here lands in a release
# commit unless it is ignored. Force-add with `git add -f` if one is ever
# genuinely meant to ship.
plugins/*.zip
*.bak
*.bak-*
*.orig
*.rej

# remuxing-to-mov synthetic test corpus — regenerated on demand by
# tests/make-fixtures.sh; media never ships in git (the plugin-level
# .gitignore only covers *.mov, so ignore the whole directory here)
plugins/remuxing-to-mov/skills/remuxing-to-mov/tests/fixtures/
